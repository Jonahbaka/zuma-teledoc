{
  "name": "zuma-teledoc",
  "version": "1.0.0",
  "description": "DoctaRx - Production HIPAA-compliant Telehealth Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:next\"",
    "dev:next": "next dev",
    "dev:server": "nodemon server/index.js",
    "prebuild": "node scripts/copy-mediapipe.js && node scripts/generate-public-seo.js",
    "build": "next build",
    "start": "node server/index.js",
    "start:next": "next start",
    "start:server": "node --max-http-header-size=32768 server/index.js",
    "migrate": "node server/db/migrate.js",
    "ng:migrate": "node ng/migrations/migrate.js",
    "ng:seed:pack": "node ng/scripts/ingest-doctarx-nigeria-pack.js",
    "migrate:rollback": "node server/db/rollback.js",
    "seed:links": "node server/scripts/seed-testing-links.js",
    "verify:admin-test-access": "node scripts/verify-admin-test-access-flow.cjs",
    "verify:testing-link-lifecycle": "node scripts/verify-testing-link-lifecycle.cjs",
    "test": "node --test ng/tests/conferencing.test.js ng/tests/livekit-provider-conference-contract.test.js ng/tests/provider-workflow-discovery.test.js ng/tests/telehealth-lifecycle-integration.test.js ng/tests/telehealth-lifecycle-db.test.js && node ng/tests/regression.test.js && node ng/tests/portal-contract.test.js",
    "test:regression": "node ng/tests/regression.test.js",
    "test:portal": "node ng/tests/portal-contract.test.js",
    "test:sim": "node ng/scripts/simulate.js",
    "test:live-sim": "node ng/scripts/simulate-live.js",
    "test:deploy-guard": "node --test server/tests/deploy-guard.test.js server/tests/migrate-agent-tables.test.js",
    "test:deploy-gate": "npm run test:deploy-guard && npm test && npm run test:sim",
    "e2e:video:ng": "node scripts/e2e-ng-video-call.cjs",
    "e2e:livekit:sfu": "node scripts/e2e-livekit-sfu.cjs",
    "ng:seed-demo": "node ng/scripts/seed-demo-accounts.js",
    "ng:seed-demo:dry": "node ng/scripts/seed-demo-accounts.js --dry-run",
    "ng:simulate:clinical": "node ng/scripts/simulate-live-clinical-workflows.js",
    "ng:simulate:clinical:dry": "node ng/scripts/simulate-live-clinical-workflows.js --dry-run",
    "ng:simulate:conference": "node ng/scripts/simulate-conference-workflows.js",
    "ng:fixture:provider-dashboard": "node scripts/ng-provider-dashboard-fixture.cjs",
    "test:provider-portal": "node --test ng/tests/provider-portal-contract.test.js",
    "test:provider-intelligence": "node --test ng/tests/provider-clinical-intelligence.test.js",
    "test:live-clinical-simulation": "node --test ng/tests/live-clinical-simulation.test.js",
    "test:conference-simulation": "node --test ng/tests/conferencing-simulation.test.js ng/tests/livekit-provider-conference-contract.test.js",
    "test:conference-sfu-contract": "node --test ng/tests/livekit-provider-conference-contract.test.js",
    "test:ng:lifecycle:hermetic": "node --test ng/tests/telehealth-lifecycle-integration.test.js",
    "test:ng:lifecycle:db": "node --test ng/tests/telehealth-lifecycle-db.test.js",
    "test:ng:lifecycle:browser": "node scripts/e2e-ng-lifecycle-browser.cjs",
    "lint": "eslint .",
    "postinstall": "node -e \"try{require('./scripts/copy-mediapipe')}catch(e){}\"",
    "validate:db": "node scripts/validate-db.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/selfie_segmentation": "^0.1.1675465747",
    "@mediapipe/tasks-vision": "^0.10.32",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@sentry/nextjs": "^10.32.1",
    "@sentry/node": "^10.32.1",
    "axios": "^1.7.7",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.30.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "cloudinary-react": "^1.8.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.0.0",
    "html2canvas": "^1.4.1",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.0",
    "livekit-client": "^2.19.1",
    "lucide-react": "^0.562.0",
    "multer": "^2.0.2",
    "next": "^15.5.9",
    "nodemailer": "^7.0.12",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-ga4": "^2.1.0",
    "react-hook-form": "^7.53.1",
    "recharts": "^2.13.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^20.1.0",
    "tailwind-merge": "^3.4.0",
    "twitter-api-v2": "^1.29.0",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "ws": "~8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "next.config.js",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
