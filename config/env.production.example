## Production env (example)
#
# Copy this file to `.env.production` in the project root and fill in real values.
# NOTE: `.env.production` is intentionally not committed.
#
# Public base URLs
NEXT_PUBLIC_APP_URL=https://doctarx.com
NEXT_PUBLIC_API_URL=https://doctarx.com/api

PORT=3001
NODE_ENV=production

# Database (production)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Auth / crypto (production)
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY
SESSION_SECRET=REPLACE_WITH_STRONG_SECRET

# Stripe (production)
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

