## Production env (example)
#
# Copy this file to `.env.production` in the project root and fill in real values.
# NOTE: `.env.production` is intentionally not committed.
#
# Public base URLs
NEXT_PUBLIC_APP_URL=https://doctarx.com
NEXT_PUBLIC_API_URL=https://doctarx.com/api

PORT=3001
NODE_ENV=production

# Database (production)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Auth / crypto (production)
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY
SESSION_SECRET=REPLACE_WITH_STRONG_SECRET

# Stripe (production)
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# GA4 realtime analytics bridge (optional)
# Property ID is numeric and must have Analytics Data API access.
GA4_PROPERTY_ID=523207857
GA4_CLIENT_EMAIL=ga-realtime@your-project.iam.gserviceaccount.com
# Keep line breaks escaped as \n
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Zoho Recruit OAuth (server callback)
ZOHO_RECRUIT_CLIENT_ID=REPLACE_ME
ZOHO_RECRUIT_CLIENT_SECRET=REPLACE_ME
ZOHO_RECRUIT_REDIRECT_URI=https://doctarx.com/api/auth/zoho/recruit/callback
# Optional: set for your Zoho DC if not default .com
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_RECRUIT_API_BASE_URL=https://recruit.zoho.com
ZOHO_RECRUIT_SCOPE=ZohoRecruit.modules.ALL,ZohoRecruit.settings.ALL
# Optional fixed state to enforce CSRF check during callback
# ZOHO_RECRUIT_OAUTH_STATE=REPLACE_ME
