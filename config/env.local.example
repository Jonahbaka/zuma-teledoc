## Local development env (example)
#
# Copy this file to `.env.local` in the project root and fill in real values.
# NOTE: `.env.local` is intentionally not committed.
#
# Next.js dev (frontend): http://localhost:3000
# Express API (backend):  http://localhost:3001

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Auth / crypto
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_SECRET
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_KEY
SESSION_SECRET=REPLACE_WITH_STRONG_SECRET

# Stripe (optional in local)
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Email (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@doctarx.com

