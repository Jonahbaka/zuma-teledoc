# Frontend-only DoctaRx CareOps profile. Replace both example hosts with approved
# real deployment values. The production validator rejects .invalid hosts.
DOCTARX_PRODUCT_PROFILE=careops
NEXT_PUBLIC_DOCTARX_PRODUCT_PROFILE=careops
DOCTARX_DEPLOYMENT_ID=doctarx-careops
NEXT_PUBLIC_APP_URL=https://institution-approved-host.example.invalid
NEXT_PUBLIC_API_URL=/api
DOCTARX_API_PROXY_TARGET=https://existing-shared-api.example.invalid/api
NEXT_DIST_DIR=.next-careops
PORT=3000
CAREOPS_HOST=0.0.0.0
# Comma-separated exact HTTPS/WSS SFU/TURN-related origins, once approved.
# No wildcard network access is granted by the profile.
CAREOPS_MEDIA_ORIGINS=

# Configure separately on the EXISTING shared backend; do not copy its secrets
# or DATABASE_URL into this frontend deployment:
# AUTH_COOKIE_DOMAIN_MODE=host-only
# Actual backend CORS/proxy trust, approved institutional origin, MFA, HTTPS,
# websockets/TURN/SFU and identity provisioning require staging acceptance.
