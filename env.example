# ===========================================
# ZumaTeledocAI Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# AWS (required for deployment on AWS infrastructure)
# ===========================================
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ===========================================
# DATABASE
# ===========================================
# For AWS RDS with full SSL verification, use sslmode=verify-full
DATABASE_URL=postgres://postgres:your-db-password@your-rds-host.rds.amazonaws.com:5432/postgres?sslmode=verify-full

# Path to the RDS SSL certificate bundle (downloaded by deploy.sh)
# Manually: wget -O global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
PGSSLROOTCERT=./global-bundle.pem

# ===========================================
# JWT SECRETS (generate secure 64-char secrets)
# ===========================================
JWT_ACCESS_SECRET=your-64-character-access-token-secret-here
JWT_REFRESH_SECRET=your-64-character-refresh-token-secret-here

# ===========================================
# ENCRYPTION (32-byte key for AES-256)
# ===========================================
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ===========================================
# SESSION
# ===========================================
SESSION_SECRET=your-session-secret-here

# ===========================================
# APPLICATION URLs
# ===========================================
# For development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# For production (replace with your domain):
NEXT_PUBLIC_APP_URL=https://doctarx.com
NEXT_PUBLIC_API_URL=https://doctarx.com/api

# ===========================================
# SERVER
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# STRIPE (for payment processing)
# ===========================================
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_key_here
STRIPE_SECRET_KEY=sk_live_or_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# When true, Stripe Checkout uses automatic payment methods (local cards/bank methods) with a safe card-only fallback.
STRIPE_AUTOMATIC_PAYMENT_METHODS_ENABLED=true

# ===========================================
# EMAIL (SMTP Configuration)
# ===========================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@domain.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@yourdomain.com

# ===========================================
# ZOHO RECRUIT OAUTH (server-side callback)
# ===========================================
ZOHO_RECRUIT_CLIENT_ID=your_zoho_client_id
ZOHO_RECRUIT_CLIENT_SECRET=your_zoho_client_secret
ZOHO_RECRUIT_REDIRECT_URI=https://doctarx.com/api/auth/zoho/recruit/callback
# Optional: set if you use custom Zoho data center
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
# Optional: override Recruit API base URL
ZOHO_RECRUIT_API_BASE_URL=https://recruit.zoho.com
# Scope: prefer least-privilege in production.
# NOTE: ZohoRecruit.modules.ALL and ZohoRecruit.settings.ALL are broad scopes.
ZOHO_RECRUIT_SCOPE=ZohoRecruit.modules.ALL,ZohoRecruit.settings.ALL
# Optional CSRF state check if you use fixed state value
# ZOHO_RECRUIT_OAUTH_STATE=your_state_value

# ===========================================
# GOOGLE CLOUD (for AI/OCR features)
# ===========================================
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_PROJECT_ID=your-project-id

# ===========================================
# GA4 REALTIME ANALYTICS (optional, for live admin analytics)
# ===========================================
# Numeric GA4 property id (not measurement id)
GA4_PROPERTY_ID=523207857
# Service account email with Analytics Viewer access to the property
GA4_CLIENT_EMAIL=ga-realtime@your-project.iam.gserviceaccount.com
# RSA private key for that service account (single line with \n escaped)
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ===========================================
# OPTIONAL: Feature Flags
# ===========================================
# ENABLE_MFA=true
# ENABLE_VIDEO_CALLS=true
# ENABLE_AI_TRIAGE=true

# ===========================================
# OBSERVABILITY / ALERTING (recommended for production)
# ===========================================
# ALERT_ADMIN_EMAIL=evolvedu@outlook.com
# ALERT_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
# READINESS_ALERTS=false

# ===========================================
# SENTRY (optional but recommended)
# ===========================================
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

